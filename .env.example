# Copy this file to .env. Never commit the populated file.
# Production docker-compose requires a generated database password.
POSTGRES_PASSWORD=
ALLOWED_HOSTS=

# ASP.NET Core Identity bootstrap and optional external identity providers.
AUTH_ADMIN_BOOTSTRAP_EMAIL=
AUTH_ADMIN_BOOTSTRAP_PASSWORD=
AUTH_ADMIN_BOOTSTRAP_DISPLAY_NAME=Administrator
AUTH_SESSION_HOURS=336
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Email confirmation and password reset. Use an HTTPS frontend URL in production.
PUBLIC_FRONTEND_BASE_URL=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Canvas To Do
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true
SMTP_TIMEOUT_SECONDS=15
# Makes local registration/reset usable without SMTP. Production Compose forces
# this off, and the API only honors it in ASPNETCORE_ENVIRONMENT=Development.
EMAIL_DEVELOPMENT_EXPOSE_TOKENS=true

# SFU Canvas OAuth is preferred. The callback must be the exact public HTTPS URL.
CANVAS_ALLOWED_INSTANCE_URLS=https://sfu.instructure.com,https://canvas.ubc.ca,https://canvas.usask.ca,https://canvas.uw.edu,https://canvas.stanford.edu,https://canvas.harvard.edu,https://q.utoronto.ca,https://bruinlearn.ucla.edu,https://bcourses.berkeley.edu,https://canvas.it.umich.edu,https://canvas.illinois.edu,https://canvas.umn.edu,https://canvas.virginia.edu,https://canvas.colorado.edu,https://canvas.upenn.edu,https://login.canvas.cornell.edu,https://etl.snu.ac.kr,https://lms.korea.ac.kr,https://icampus.skku.edu,https://canvas.suwon.ac.kr
CANVAS_OAUTH_ENABLED=false
CANVAS_OAUTH_CLIENT_ID=
CANVAS_OAUTH_CLIENT_SECRET=
CANVAS_OAUTH_CALLBACK_URL=

# Temporary fallback when institutional Canvas OAuth is unavailable.
# Leave blank to use the Compose defaults: enabled for local development and
# disabled in production. Set true in production only as a deliberate decision.
CANVAS_MANUAL_TOKEN_ENABLED=
