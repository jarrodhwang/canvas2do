# Copy to deploy/.env on the Lightsail server and chmod 600. Never commit it.
APP_DOMAIN=example.com
POSTGRES_DB=incos_workspace
POSTGRES_USER=incos
POSTGRES_PASSWORD=

API_MEMORY_CACHE_MB=16
AUTH_SESSION_HOURS=168
AUTH_ADMIN_BOOTSTRAP_EMAIL=
AUTH_ADMIN_BOOTSTRAP_PASSWORD=
AUTH_ADMIN_BOOTSTRAP_DISPLAY_NAME=Administrator

PUBLIC_FRONTEND_BASE_URL=https://example.com
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Canvas To Do
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true
SMTP_TIMEOUT_SECONDS=15

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

CANVAS_ALLOWED_INSTANCE_URLS=https://sfu.instructure.com,https://canvas.ubc.ca,https://canvas.usask.ca,https://canvas.uw.edu,https://canvas.stanford.edu,https://canvas.harvard.edu
CANVAS_OAUTH_ENABLED=false
CANVAS_OAUTH_CLIENT_ID=
CANVAS_OAUTH_CLIENT_SECRET=
CANVAS_OAUTH_CALLBACK_URL=https://example.com/api/canvas/oauth/callback
CANVAS_MANUAL_TOKEN_ENABLED=false
